@external
@pure
def calculate(x: decimal) -> decimal:
    """
    @notice Calculate atan(x) for any x (FREE - no gas cost)
    @param x Input value
    @return Angle in radians [-π/2, π/2]
    """
    # Handle negative: atan(-x) = -atan(x)
    if x < 0.0:
        return -self._atan(-x)
    
    return self._atan(x)

@external
@pure
def get_constant() -> decimal:
    """
    @notice Get π/4 = atan(1)
    @return The constant π/4 = 0.7853981634
    """
    return ATAN_TABLE[499]

@internal
@pure
def _atan(x: decimal) -> decimal:
    """
    @notice Calculate atan(x) for x >= 0
    @param x Input value (must be >= 0)
    @return atan(x)
    """
    # Handle x > 1: atan(x) = π/2 - atan(1/x)
    if x > 1.0:
        reciprocal: decimal = 1.0 / x
        return HALF_PI - self._atan_small(reciprocal)
    
    # For x in [0, 1], use table lookup
    return self._atan_small(x)

@internal
@pure
def _atan_small(x: decimal) -> decimal:
    """
    @notice Lookup atan(x) for x in [0, 1]
    @param x Input value (must be in [0, 1])
    @return atan(x)
    """
    # Find position in table
    pos: decimal = x * INV_STEP
    idx: uint256 = convert(pos, uint256)
    
    # If at or past end of table
    if idx >= 499:
        return ATAN_TABLE[499]
    
    # Linear interpolation
    frac: decimal = pos - convert(idx, decimal)
    val_low: decimal = ATAN_TABLE[idx]
    val_high: decimal = ATAN_TABLE[idx + 1]
    
    return val_low + frac * (val_high - val_low)

