/// Test FP_NORMALIZE in isolation
#include "fp_constants.huff"

#define macro FP_NORMALIZE() = takes(2) returns(2) {
    dup2 iszero               // [mantissa == 0, exp, mantissa]
    normalize_done jumpi      // if zero, skip normalization
    
    normalize_down:
        dup2                  // [mantissa, exp, mantissa]
        [MAX_MANTISSA]        // [MAX, mantissa, exp, mantissa]
        lt                    // [mantissa < MAX, exp, mantissa]
        normalize_up jumpi    // if mantissa < MAX, go to up normalization
        
        swap1                 // [mantissa, exp]
        [TEN_UINT] div        // [mantissa / 10, exp]
        swap1                 // [exp, mantissa / 10]
        0x01 add              // [exp + 1, mantissa / 10]
        swap1                 // [mantissa / 10, exp + 1]
        normalize_down jump   // loop
    
    normalize_up:
        dup2                  // [mantissa, exp, mantissa]
        [MIN_MANTISSA]        // [MIN, mantissa, exp, mantissa]
        lt                    // [mantissa < MIN, exp, mantissa]
        iszero                // [mantissa >= MIN, exp, mantissa]
        normalize_done jumpi  // if mantissa >= MIN, done
        
        dup2 iszero           // [mantissa == 0, exp, mantissa]
        normalize_done jumpi
        
        swap1                 // [mantissa, exp]
        [TEN_UINT] mul        // [mantissa * 10, exp]
        swap1                 // [exp, mantissa * 10]
        0x01 sub              // [exp - 1, mantissa * 10]
        swap1                 // [mantissa * 10, exp - 1]
        normalize_up jump     // loop
    
    normalize_done:
        // [exp, mantissa]
}

#define macro MAIN() = takes(0) returns(0) {
    0x04 calldataload         // [mantissa]
    0x24 calldataload         // [exp, mantissa]
    FP_NORMALIZE()            // [norm_exp, norm_mant]
    0x20 mstore               // [norm_exp]
    0x00 mstore               // []
    0x40 0x00 return
}
