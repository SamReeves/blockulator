/// Test basic math

#define macro MAIN() = takes(0) returns(0) {
    0x00 calldataload 0xe0 shr
    
    dup1 0x8dfa4363 eq calculate_jump jumpi
    0x00 0x00 revert
    
    calculate_jump:
        pop
        // Return (arg1 * arg2) / 1e36
        0x04 calldataload
        0x24 calldataload
        mul
        0xc097ce7bc90715b34b9f1000000000
        swap1
        div
        0x00 mstore
        0x20 0x00 return
}

#define function calculate(uint256,uint256) pure returns (uint256)
