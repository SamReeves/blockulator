/// @title 128.128 Fixed-Point Arithmetic Library
/// @notice Signed fixed-point operations using two's complement
/// @dev Format: 128 integer bits + 128 fractional bits
///      All operations preserve sign via two's complement

#include "fp128_constants.huff"

/// @notice Add two 128.128 fixed-point numbers
/// @dev takes(2) returns(1)
/// Stack input: [a, b]
/// Stack output: [a + b]
#define macro FP128_ADD() = takes(2) returns(1) {
    add
}

/// @notice Subtract two 128.128 fixed-point numbers
/// @dev takes(2) returns(1)
/// Stack input: [a, b] (b on top)
/// Stack output: [a - b]
#define macro FP128_SUB() = takes(2) returns(1) {
    swap1     // [a, b] -> [b, a]
    sub       // b - a
}

/// @notice Convert signed fixed18 to 128.128 format
/// @dev takes(1) returns(1)
/// Stack input: [fixed18_value] (signed int256 representing value * 1e18)
/// Stack output: [fp128_value] (signed int256 representing value * 2^128)
/// Formula: fp128 = (fixed18 * 2^128) / 1e18
#define macro FP128_FROM_FIXED18() = takes(1) returns(1) {
    // Input: [fixed18]
    // We need: (fixed18 * 2^128) / 1e18
    // For typical calculator use (values up to ~10^20), we're safe:
    // 10^20 * 2^128 ≈ 2^195, well within 256 bits.
    
    [ONE_FP128]           // [2^128, fixed18]
    mul                   // [fixed18 * 2^128]
    [FIXED18_SCALE]       // [1e18, fixed18 * 2^128]
    swap1                 // [fixed18 * 2^128, 1e18]
    sdiv                  // [(fixed18 * 2^128) / 1e18]
}

/// @notice Convert 128.128 format to signed fixed18
/// @dev takes(1) returns(1)
/// Stack input: [fp128_value] (signed int256 representing value * 2^128)
/// Stack output: [fixed18_value] (signed int256 representing value * 1e18)
/// Formula: fixed18 = (fp128 * 1e18) / 2^128
///          Use arithmetic right shift to preserve sign
#define macro FP128_TO_FIXED18() = takes(1) returns(1) {
    // Input: [fp128]
    // We need: (fp128 * 1e18) >> 128
    // Use signed operations to preserve sign
    
    [FIXED18_SCALE]       // [1e18, fp128]
    mul                   // [fp128 * 1e18]
    [FRAC_BITS]           // [128, fp128 * 1e18]
    sar                   // [(fp128 * 1e18) >> 128 (arithmetic)]
}

/// @notice Multiply two 128.128 fixed-point numbers
/// @dev takes(2) returns(1)
/// Stack input: [b, a] (b on top)
/// Stack output: [a * b]
/// Formula: result = (a * b) / 2^128
///          Split both operands to avoid overflow (4-term schoolbook)
#define macro FP128_MUL() = takes(2) returns(1) {
    // Input: [b, a]
    // Split both: a = a_hi * 2^128 + a_lo, b = b_hi * 2^128 + b_lo
    // Result = a_hi * b_hi * 2^128 + a_hi * b_lo + a_lo * b_hi + (a_lo * b_lo) >> 128
    
    // Extract hi/lo parts
    dup2 [FRAC_BITS] sar  // [a_hi, b, a]
    dup3 [MASK128] and    // [a_lo, a_hi, b, a]
    dup3 [FRAC_BITS] sar  // [b_hi, a_lo, a_hi, b, a]
    dup4 [MASK128] and    // [b_lo, b_hi, a_lo, a_hi, b, a]
    
    // Stack: [b_lo, b_hi, a_lo, a_hi, b, a]
    //  pos:    0     1     2     3    4  5
    
    // Term1: (a_hi * b_hi) << 128
    // Need a_hi (pos 3) and b_hi (pos 1)
    dup4                  // [a_hi, b_lo, b_hi, a_lo, a_hi, b, a]
    dup3                  // [b_hi, a_hi, b_lo, b_hi, a_lo, a_hi, b, a]
    mul                   // [a_hi * b_hi, b_lo, b_hi, a_lo, a_hi, b, a]
    [FRAC_BITS] shl       // [term1, b_lo, b_hi, a_lo, a_hi, b, a]
    
    // Term2: a_hi * b_lo
    // Stack: [term1, b_lo, b_hi, a_lo, a_hi, b, a]
    //  pos:    0     1     2     3     4    5  6
    // Need a_hi (pos 4) and b_lo (pos 1)
    dup5                  // [a_hi, term1, b_lo, b_hi, a_lo, a_hi, b, a]
    dup3                  // [b_lo, a_hi, term1, b_lo, b_hi, a_lo, a_hi, b, a]
    mul                   // [a_hi * b_lo, term1, b_lo, b_hi, a_lo, a_hi, b, a]
    add                   // [sum12, b_lo, b_hi, a_lo, a_hi, b, a]
    
    // Term3: a_lo * b_hi
    // Stack: [sum12, b_lo, b_hi, a_lo, a_hi, b, a]
    //  pos:    0     1     2     3     4    5  6
    // Need a_lo (pos 3) and b_hi (pos 2)
    dup4                  // [a_lo, sum12, b_lo, b_hi, a_lo, a_hi, b, a]
    dup4                  // [b_hi, a_lo, sum12, b_lo, b_hi, a_lo, a_hi, b, a]
    mul                   // [a_lo * b_hi, sum12, b_lo, b_hi, a_lo, a_hi, b, a]
    add                   // [sum123, b_lo, b_hi, a_lo, a_hi, b, a]
    
    // Term4: (a_lo * b_lo) >> 128
    // Stack: [sum123, b_lo, b_hi, a_lo, a_hi, b, a]
    //  pos:    0      1     2     3     4    5  6
    // Need a_lo (pos 3) and b_lo (pos 1)
    dup4                  // [a_lo, sum123, b_lo, b_hi, a_lo, a_hi, b, a]
    dup3                  // [b_lo, a_lo, sum123, b_lo, b_hi, a_lo, a_hi, b, a]
    mul                   // [a_lo * b_lo, sum123, b_lo, b_hi, a_lo, a_hi, b, a]
    [FRAC_BITS] shr       // [term4, sum123, b_lo, b_hi, a_lo, a_hi, b, a]
    add                   // [result, b_lo, b_hi, a_lo, a_hi, b, a]
    
    // Clean stack: pop 6 items
    swap1 pop swap1 pop swap1 pop swap1 pop swap1 pop swap1 pop
    // [result]
}

/// @notice Divide two 128.128 fixed-point numbers
/// @dev takes(2) returns(1)
/// Stack input: [b, a] (b on top)
/// Stack output: [a / b]
/// Formula: result = (a * 2^128) / b
///          Use 64-bit chunked shift-and-divide to avoid overflow
#define macro FP128_DIV() = takes(2) returns(1) {
    // Input: [b, a]
    // We want: (a * 2^128) / b
    // Problem: a * 2^128 overflows
    // Solution: shift by 64 bits at a time, divide after each shift
    //   q1 = (a << 64) / b     (top 64 bits of result)
    //   r1 = (a << 64) % b     (remainder)
    //   q2 = (r1 << 64) / b    (next 64 bits)
    //   result = (q1 << 64) + q2
    
    swap1                      // [a, b]
    [HALF_FRAC_BITS] shl       // [a << 64, b]
    dup1 dup3 swap1 sdiv       // [q1, a<<64, b]
    swap2                      // [b, a<<64, q1]
    dup1 swap2 smod            // [r1, b, q1]
    [HALF_FRAC_BITS] shl       // [r1 << 64, b, q1]
    swap1 sdiv                 // [q2, q1]
    swap1 [HALF_FRAC_BITS] shl // [q1 << 64, q2]
    add                        // [result]
}
