
#define macro MAIN() = takes(0) returns(0) {
    0x00 calldataload
    0x04 shr
    dup1 __FUNC_SIG(passthrough) eq pt_jump jumpi
    0x00 0x00 revert
    
    pt_jump:
        pop
        0x04 calldataload      // [a]
        0x24 calldataload      // [b, a]
        // Just return both values
        0x00 mstore            // [a]
        0x20 mstore            // []
        0x40 0x00 return
}

#define function passthrough(uint256,uint256) pure returns (uint256,uint256)
