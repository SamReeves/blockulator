/// @title Two Iteration Exp Test
/// @notice Test exactly two iterations of the product rule
/// @dev Level 3: Verify digit extraction for second iteration and x = (x - d*SCALE) * 10

#include "fp_constants.huff"
#include "tables/exp_table.huff"

#define macro MAIN() = takes(0) returns(0) {
    0x00 calldataload 0xe0 shr
    
    dup1 __FUNC_SIG(calculate) eq calculate_jump jumpi
    0x00 0x00 revert
    
    calculate_jump:
        pop
        // Load x_fixed18
        0x04 calldataload
        
        // Convert to scaled36: x = x_fixed18 * 10^18
        [FIXED18_SCALE] mul       // [x_scaled36]
        
        // y = SCALE (1.0)
        [SCALE] 0x00 mstore       // []
        
        // Stack: [x]
        0x00                      // [i=0, x]
        
        /// ITERATION 0
        dup2                      // [x, i, x]
        [SCALE] swap1 div         // [d, i, x]
        
        dup1 dup3                 // [i, d, d, i, x]
        EXP_TABLE_LOOKUP()        // [factor, d, i, x]
        
        0x00 mload                // [y, factor, d, i, x]
        swap1                     // [factor, y, d, i, x]
        mul                       // [y*factor, d, i, x]
        [SCALE]                   // [SCALE, y*factor, d, i, x]
        swap1 div                 // [(y*factor)/SCALE, d, i, x] = [y_new, d, i, x]
        0x00 mstore               // [d, i, x]
        
        [SCALE] mul               // [d*SCALE, i, x]
        dup3 sub                  // [x - d*SCALE, i, x]
        [TEN] mul                 // [x_new, i, x]
        swap2 pop                 // [x_new, i]
        swap1                     // [i, x_new]
        0x01 add                  // [i=1, x_new]
        
        /// ITERATION 1
        dup2                      // [x, i, x]
        [SCALE] swap1 div         // [d, i, x]
        
        dup1 dup3                 // [i, d, d, i, x]
        EXP_TABLE_LOOKUP()        // [factor, d, i, x]
        
        0x00 mload                // [y, factor, d, i, x]
        swap1                     // [factor, y, d, i, x]
        mul                       // [y*factor, d, i, x]
        [SCALE]                   // [SCALE, y*factor, d, i, x]
        swap1 div                 // [(y*factor)/SCALE, d, i, x] = [y_new, d, i, x]
        0x00 mstore               // [d, i, x]
        
        // Clean up and return
        pop pop pop               // []
        0x00 mload                // [y]
        [FIXED18_SCALE] swap1 div // [result_fixed18]
        
        0x00 mstore
        0x20 0x00 return
}

#define function calculate(uint256) pure returns (uint256)
