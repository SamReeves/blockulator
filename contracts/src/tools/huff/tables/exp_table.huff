/// @notice Load EXP_TABLE_DATA[i][d] via codecopy
/// @dev takes(2) returns(1)
/// Stack input: [i, d]   (i = row 0-18, d = digit 0-9)
/// Stack output: [scaled_value]  (value * 10^36)
/// Uses memory at 0xc0 as scratch
#define macro EXP_TABLE_LOOKUP() = takes(2) returns(1) {
    // offset = (i * 10 + d) * 32
    swap1                       // [d, i]
    swap1 0x0a mul              // [i*10, d]
    add                         // [i*10 + d]
    0x20 mul                    // [byte_offset]

    // codecopy(destOffset, offset, size)
    0x20                        // [size=32, byte_offset]
    swap1                       // [byte_offset, size]
    __tablestart(EXP_TABLE_DATA)
    add                         // [code_offset, size]
    0xc0                        // [dest=0xc0, code_offset, size]
    codecopy                    // []
    0xc0 mload                  // [scaled_value]
}
