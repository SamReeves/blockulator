/// Minimal FP test contract
#include "fp.huff"

#define macro MAIN() = takes(0) returns(0) {
    0x00 calldataload 0xe0 shr
    
    dup1 __FUNC_SIG(test_convert) eq test_convert_jump jumpi
    dup1 __FUNC_SIG(test_mul) eq test_mul_jump jumpi
    dup1 __FUNC_SIG(test_add) eq test_add_jump jumpi
    0x00 0x00 revert
    
    test_convert_jump:
        pop
        0x04 calldataload     // [fixed18]
        FP_FROM_FIXED18()     // [fp]
        FP_TO_FIXED18()       // [fixed18]
        0x00 mstore
        0x20 0x00 return
    
    test_mul_jump:
        pop
        0x04 calldataload     // [a]
        FP_FROM_FIXED18()     // [a_fp]
        0x24 calldataload     // [b, a_fp]
        FP_FROM_FIXED18()     // [b_fp, a_fp]
        FP_MUL()              // [result_fp]
        FP_TO_FIXED18()       // [result]
        0x00 mstore
        0x20 0x00 return
    
    test_add_jump:
        pop
        0x04 calldataload     // [a]
        FP_FROM_FIXED18()     // [a_fp]
        0x24 calldataload     // [b, a_fp]
        FP_FROM_FIXED18()     // [b_fp, a_fp]
        FP_ADD()              // [result_fp]
        FP_TO_FIXED18()       // [result]
        0x00 mstore
        0x20 0x00 return
}

#define function test_convert(uint256) pure returns (uint256)
#define function test_mul(uint256,uint256) pure returns (uint256)
#define function test_add(uint256,uint256) pure returns (uint256)
