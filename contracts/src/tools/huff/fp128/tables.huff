/// @title FP128 BKM Lookup Table for Transcendental Functions
/// @notice BKM algorithm table for exp and ln (shift-add method)
/// @dev Generated by scripts/generate_fp128_tables.py
/// @dev Each entry is a 32-byte FP128 value (128.128 format)
///
/// BKM Algorithm (exp):
///   exp(x) where x is FP128, x >= 0:
///   acc = ONE_FP128, rem = x
///   for k = 0 to 134:
///       if rem >= BKM_LN_TABLE[k]:
///           acc = acc + (acc >> k)   // multiply by (1 + 2^-k)
///           rem = rem - BKM_LN_TABLE[k]
///   return acc
///
/// BKM Algorithm (ln):
///   ln(x) where x is FP128, x >= 1:
///   result = 0, acc = ONE_FP128
///   for k = 0 to 134:
///       trial = acc + (acc >> k)   // multiply by (1 + 2^-k)
///       if trial <= x:
///           acc = trial
///           result = result + BKM_LN_TABLE[k]
///   return result

/// @notice Constants for BKM transcendental functions

// BKM_TABLE_SIZE: number of entries in BKM_LN_TABLE
#define constant BKM_TABLE_SIZE = 0x80  // 128

// BKM_MAX_K: highest k index in table (127)
#define constant BKM_MAX_K = 0x7F  // 127

// LN2_FP128: ln(2) = BKM_LN_TABLE[0] (already defined in constants.huff)
// Value: 0.69314718055994530941723212145817656807550013436025525412068000949339362196969472


