/// @title FP128 Transcendental Functions
/// @notice exp, ln, sqrt for 128.128 fixed-point arithmetic
/// @dev Uses binary digit-by-digit table method:
///      exp(x): for each set bit k in x, multiply accumulator by EXP_BIT_TABLE[k]
///      ln(x):  for each bit from MSB down, test-divide by e^(2^k), set bit if >= 1
///      sqrt(x) = exp(ln(x) / 2)

#include "arithmetic.huff"
#include "tables.huff"

// ============================================================================
// EXP Sub-Macros: Decomposed components for clean stack management
// ============================================================================

/// @notice Range reduction for exp: k_int = floor(x / ln2), x' = x - k_int * ln2
/// @dev takes(1) returns(2)
/// Stack input:  [x] (FP128 value)
/// Stack output: [k_int, x_prime] where x_prime is in [0, ln(2))
#define macro EXP_RANGE_REDUCE() = takes(1) returns(2) {
    // [x]
    dup1                              // [x, x]
    [INV_LN2_FP128]                   // [INV_LN2, x, x]
    FP128_MUL()                       // [x/ln2, x]
    0x80 sar                          // [k_int, x]
    
    // x' = x - k_int * ln2
    dup1 0x80 shl                     // [k_int_fp128, k_int, x]
    [LN2_FP128]                       // [LN2, k_int_fp128, k_int, x]
    FP128_MUL()                       // [k_int*ln2, k_int, x]
    dup3 sub                          // [x - k_int*ln2, k_int, x]
    swap2 pop                         // [k_int, x']
}

/// @notice BKM exponential loop: computes exp(remainder) via shift-add iteration
/// @dev takes(1) returns(1)
/// Stack input:  [remainder] (FP128 value in [0, ln(2)))
/// Stack output: [accumulator] (exp of remainder)
#define macro EXP_BKM_LOOP() = takes(1) returns(1) {
    // [rem]
    [ONE_FP128] swap1                 // [rem, acc]
    0x00                              // [k=0, rem, acc]
    
    bkm_loop_start:
        // Load L[k] from BKM_LN_TABLE
        dup1 0x20 mul                 // [byte_off, k, rem, acc]
        __tablestart(BKM_LN_TABLE)    // [tbl, byte_off, k, rem, acc]
        add                           // [src, k, rem, acc]
        0x00 swap1 0x20 swap2         // [dest, src, size, k, rem, acc]
        codecopy                      // [k, rem, acc]
        0x00 mload                    // [L_k, k, rem, acc]
        
        // Check if rem >= L_k
        dup3 dup2 swap1 slt           // [rem < L_k, L_k, k, rem, acc]
        bkm_loop_skip jumpi
        
        // rem >= L_k: acc += (acc >> k), rem -= L_k
        dup4 dup3 shr                 // [acc >> k, L_k, k, rem, acc]
        dup5 add                      // [new_acc, L_k, k, rem, old_acc]
        swap4 pop                     // [L_k, k, rem, new_acc]
        
        dup3 sub                      // [rem - L_k, k, rem, new_acc]
        swap2 pop                     // [k, new_rem, new_acc]
        
        0x01 add                      // [k+1, rem, acc]
        dup1 [BKM_TABLE_SIZE] eq bkm_loop_done jumpi
        bkm_loop_start jump
        
    bkm_loop_skip:
        pop                           // [k, rem, acc]
        0x01 add                      // [k+1, rem, acc]
        dup1 [BKM_TABLE_SIZE] eq bkm_loop_done jumpi
        bkm_loop_start jump
    
    bkm_loop_done:
        pop pop                       // [acc]
}

/// @notice Scale accumulator by 2^k_int
/// @dev takes(2) returns(1)
/// Stack input:  [k_int, acc]
/// Stack output: [result] (acc scaled by 2^k_int)
#define macro EXP_SCALE() = takes(2) returns(1) {
    // [k_int, acc]
    dup1 0x00 swap1 slt scale_negative jumpi
    
    // k_int >= 0: left shift
    shl                               // [acc << k_int]
    scale_end jump
    
    scale_negative:
        0x00 sub                      // [|k_int|, acc]
        swap1 sar                     // [acc >> |k_int|]
    
    scale_end:
}

// ============================================================================
// FP128_EXP: Exponential function e^x
// ============================================================================

/// @notice Compute e^x using BKM algorithm (shift-add method)
/// @dev takes(1) returns(1)
/// Stack input:  [x] (128.128 format, signed)
/// Stack output: [exp(x)] (128.128 format)
///
/// BKM Algorithm:
///   1. Handle negative: exp(-x) = 1/exp(x)
///   2. Range reduce: k_int = floor(x / ln2), x' = x - k_int * ln2
///   3. BKM loop for k = 0 to 127:
///        if rem >= L[k]: acc += (acc >> k), rem -= L[k]
///   4. Scale by 2^k_int
///
/// Gas: ~2-3k (vs ~13-29k for table-mul method)
#define macro FP128_EXP() = takes(1) returns(1) {
    // Input: [x]
    dup1 iszero exp_zero jumpi
    
    // Check overflow: x > 88
    dup1 [EXP_OVERFLOW_THRESHOLD] swap1 sgt exp_overflow jumpi
    
    // Check underflow: x < -88
    dup1 [EXP_UNDERFLOW_THRESHOLD] swap1 slt exp_underflow jumpi
    
    // Check if x < 0: need reciprocal
    dup1 0x00 swap1 slt exp_negative jumpi
    
    // x >= 0: direct computation
    EXP_RANGE_REDUCE()                // [k_int, x']
    swap1                             // [x', k_int]
    EXP_BKM_LOOP()                    // [acc, k_int]
    swap1                             // [k_int, acc]
    EXP_SCALE()                       // [result]
    exp_done jump
    
    exp_negative:
        0x00 sub                      // [|x|]
        EXP_RANGE_REDUCE()            // [k_int, x']
        swap1 EXP_BKM_LOOP()          // [acc, k_int]
        swap1 EXP_SCALE()             // [result]
        [ONE_FP128] swap1             // [result, ONE]
        FP128_DIV()                   // [ONE/result]
        exp_done jump
    
    exp_overflow:
        pop
        0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
        exp_done jump
    
    exp_underflow:
        pop
        0x00
        exp_done jump
    
    exp_zero:
        pop
        [ONE_FP128]
        exp_done jump
    
    exp_done:
}

// ============================================================================
// FP128_LN: Natural logarithm
// ============================================================================

/// =============================================================================
/// LN Sub-Macros (for decomposed testing and clarity)
/// =============================================================================

/// @notice Range reduction for ln: normalize x to [1,2)
/// @dev takes(1) returns(2)
/// Stack input:  [x]
/// Stack output: [shift_k, x_reduced]
#define macro LN_RANGE_REDUCE() = takes(1) returns(2) {
    // [x]
    0x00                           // [shift_k=0, x]
    
    ln_rr_loop:
        // Check if x_reduced < 2.0 (ONE_FP128 << 1)
        [ONE_FP128] 0x01 shl       // [2.0, shift_k, x]
        dup3 lt                    // [x < 2.0, shift_k, x]
        ln_rr_done jumpi
        
        // x >= 2.0: divide by 2, increment shift_k
        swap1 0x01 shr             // [x/2, shift_k]
        swap1 0x01 add             // [shift_k+1, x/2]
        ln_rr_loop jump
    
    ln_rr_done:
        // [shift_k, x_reduced] where x_reduced in [1, 2)
}

/// @notice BKM loop for ln
/// @dev takes(1) returns(1)
/// Stack input:  [x_reduced] where x_reduced in [1,2)
/// Stack output: [ln_result]
#define macro LN_BKM_LOOP() = takes(1) returns(1) {
    // [x_reduced]
    0x00 [ONE_FP128]               // [acc=1, result=0, x_reduced]
    0x00                           // [k=0, acc, result, x_reduced]
    
    ln_bkm_loop_start:
        // trial = acc + (acc >> k)
        dup2 dup2 shr              // [acc >> k, k, acc, result, x_reduced]
        dup3 add                   // [trial, k, acc, result, x_reduced]
        
        // Check if trial > x_reduced: skip when x_reduced < trial
        dup5 dup2 swap1 lt        // [x_reduced < trial, trial, k, acc, result, x_reduced]
        ln_bkm_skip_iter jumpi
        
        // trial <= x: acc = trial, result += L[k]
        swap2 pop                  // [k, trial, result, x_reduced]
        
        // Load L[k] from table
        dup1 0x20 mul              // [byte_off, k, acc, result, x_reduced]
        __tablestart(BKM_LN_TABLE) // [tbl, byte_off, k, acc, result, x_reduced]
        add                        // [src, k, acc, result, x_reduced]
        0x00 swap1 0x20 swap2      // [dest, src, size, k, acc, result, x_reduced]
        codecopy                   // [k, acc, result, x_reduced]
        0x00 mload                 // [L_k, k, acc, result, x_reduced]
        
        dup4 add                   // [result + L_k, k, acc, old_result, x_reduced]
        swap3 pop                  // [k, acc, new_result, x_reduced]
        
        0x01 add                   // [k+1, acc, result, x_reduced]
        dup1 [BKM_TABLE_SIZE] eq ln_bkm_loop_exit jumpi
        ln_bkm_loop_start jump
        
    ln_bkm_skip_iter:
        pop                        // [k, acc, result, x_reduced]
        0x01 add                   // [k+1, acc, result, x_reduced]
        dup1 [BKM_TABLE_SIZE] eq ln_bkm_loop_exit jumpi
        ln_bkm_loop_start jump
    
    ln_bkm_loop_exit:
        // [k=128, acc, result, x_reduced]
        pop pop pop                // [result]
}

/// @notice Reconstruct full ln from BKM result and shift
/// @dev takes(2) returns(1)
/// Stack input:  [shift_k, bkm_result]
/// Stack output: [full_ln] = bkm_result + shift_k * ln(2)
#define macro LN_RECONSTRUCT() = takes(2) returns(1) {
    // [shift_k, bkm_result]
    // Convert shift_k (integer) to FP128 by shifting left 128 bits
    0x80 shl                       // [shift_k_fp128, bkm_result]
    [LN2_FP128]                    // [ln2, shift_k_fp128, bkm_result]
    swap1                          // [shift_k_fp128, ln2, bkm_result]
    FP128_MUL()                    // [shift_k * ln2, bkm_result]
    FP128_ADD()                    // [full_ln]
}

/// @notice Compute ln(x) using BKM algorithm (shift-add method)
/// @dev takes(1) returns(1)
/// Stack input:  [x] (128.128 format, must be > 0)
/// Stack output: [ln(x)] (128.128 format)
///
/// BKM Algorithm:
///   1. If x < 1: compute ln(1/x), negate
///   2. If x >= 1: range reduce to [1,2) by finding bit position
///   3. BKM loop for k = 0 to 134:
///        trial = acc + (acc >> k)
///        if trial <= x: acc = trial, result += L[k]
///   4. Add back ln(2) * bit_position from range reduction
///
/// Gas: ~2-3k (vs ~38-43k for table-mul method)
#define macro FP128_LN() = takes(1) returns(1) {
    // Input: [x]
    dup1 [ONE_FP128] eq ln_is_one jumpi
    dup1 iszero ln_is_zero jumpi
    
    // Set negate flag based on x < 1
    [ONE_FP128] dup2 lt           // [x < 1, x]
    dup1 ln_set_reciprocal jumpi  // If x < 1, jump to reciprocal path
    
    // x >= 1: negate_flag = 0, x unchanged
    pop 0x00 swap1                // [x, negate_flag=0]
    ln_compute jump
    
    ln_set_reciprocal:
        // x < 1: negate_flag = 1, x = 1/x
        pop                       // [x]
        [ONE_FP128] swap1         // [x, ONE]
        FP128_DIV()               // [1/x]
        0x01                      // [negate_flag=1, 1/x]
        swap1                     // [1/x, negate_flag]
    
    ln_compute:
        // [x, negate_flag] where x >= 1
        // Inline LN_RANGE_REDUCE
        0x00                      // [shift_k=0, x, negate_flag]
        
        ln_main_rr_loop:
            [ONE_FP128] 0x01 shl  // [2.0, shift_k, x, negate_flag]
            dup3 lt               // [x < 2.0, shift_k, x, negate_flag]
            ln_main_rr_done jumpi
            
            swap1 0x01 shr        // [x/2, shift_k, negate_flag]
            swap1 0x01 add        // [shift_k+1, x/2, negate_flag]
            ln_main_rr_loop jump
        
        ln_main_rr_done:
        // [shift_k, x_reduced, negate_flag]
        swap1                     // [x_reduced, shift_k, negate_flag]
        
        // Inline LN_BKM_LOOP
        0x00 [ONE_FP128]          // [acc=1, result=0, x_reduced, shift_k, negate_flag]
        0x00                      // [k=0, acc, result, x_reduced, shift_k, negate_flag]
        
        ln_main_bkm_loop:
            dup2 dup2 shr         // [acc >> k, k, acc, result, x_reduced, shift_k, negate_flag]
            dup3 add              // [trial, k, acc, result, x_reduced, shift_k, negate_flag]
            
            dup5 dup2 swap1 lt    // [x_reduced < trial, trial, k, acc, result, x_reduced, shift_k, negate_flag]
            ln_main_bkm_skip jumpi
            
            swap2 pop             // [k, trial, result, x_reduced, shift_k, negate_flag]
            
            dup1 0x20 mul         // [byte_off, k, acc, result, x_reduced, shift_k, negate_flag]
            __tablestart(BKM_LN_TABLE)
            add                   // [src, k, acc, result, x_reduced, shift_k, negate_flag]
            0x00 swap1 0x20 swap2 // [dest, src, size, k, acc, result, x_reduced, shift_k, negate_flag]
            codecopy              // [k, acc, result, x_reduced, shift_k, negate_flag]
            0x00 mload            // [L_k, k, acc, result, x_reduced, shift_k, negate_flag]
            
            dup4 add              // [result + L_k, k, acc, old_result, x_reduced, shift_k, negate_flag]
            swap3 pop             // [k, acc, new_result, x_reduced, shift_k, negate_flag]
            
            0x01 add              // [k+1, acc, result, x_reduced, shift_k, negate_flag]
            dup1 [BKM_TABLE_SIZE] eq ln_main_bkm_done jumpi
            ln_main_bkm_loop jump
            
        ln_main_bkm_skip:
            pop                   // [k, acc, result, x_reduced, shift_k, negate_flag]
            0x01 add              // [k+1, acc, result, x_reduced, shift_k, negate_flag]
            dup1 [BKM_TABLE_SIZE] eq ln_main_bkm_done jumpi
            ln_main_bkm_loop jump
        
        ln_main_bkm_done:
        // [k=128, acc, result, x_reduced, shift_k, negate_flag]
        pop pop                   // [result, x_reduced, shift_k, negate_flag]
        swap1 pop                 // [result, shift_k, negate_flag]
        swap1                     // [shift_k, result, negate_flag]
        
        // Inline LN_RECONSTRUCT
        0x80 shl                  // [shift_k_fp128, result, negate_flag]
        [LN2_FP128]               // [ln2, shift_k_fp128, result, negate_flag]
        swap1                     // [shift_k_fp128, ln2, result, negate_flag]
        FP128_MUL()               // [shift_k * ln2, result, negate_flag]
        FP128_ADD()               // [full_ln, negate_flag]
        
        // Check negate flag
        swap1                     // [negate_flag, full_ln]
        iszero ln_no_negate jumpi
        0x00 sub                  // [-full_ln]
    
    ln_no_negate:
        ln_done jump
    
    ln_is_one:
        pop
        0x00
        ln_done jump
    
    ln_is_zero:
        pop
        0x00
        ln_done jump
    
    ln_done:
}

// ============================================================================
// FP128_SQRT: Square root via Newton-Raphson iteration
// ============================================================================

/// @notice Compute sqrt(x) using Newton-Raphson method
/// @dev takes(1) returns(1)
/// Stack input:  [x] (128.128 format, must be >= 0)
/// Stack output: [sqrt(x)] (128.128 format)
///
/// Algorithm: Newton-Raphson iteration x_{n+1} = (x_n + a/x_n) / 2
/// Starting guess: approximate via bit position of leading 1
/// 7 iterations achieve full 128-bit precision (quadratic convergence)
///
/// Gas: ~5,000-6,000 (vs ~20,000+ for exp(ln(x)/2))
#define macro FP128_SQRT() = takes(1) returns(1) {
    // Input: [x]
    dup1 iszero sqrt_zero jumpi
    
    // Get initial guess by finding approximate magnitude
    // For x in FP128, we want sqrt(x) ≈ sqrt(2^log2(x)) = 2^(log2(x)/2)
    // Rough initial guess: use bit position
    
    dup1                                // [x, x]
    
    // Find leading bit position (rough log2)
    // Check ranges to get approximate bit position
    dup1 [ONE_FP128] lt sqrt_less_than_one jumpi
    
    // x >= 1: initial guess = x / 2 (safe overestimate)
    0x01 shr                            // [x>>1, x]
    sqrt_iterate jump
    
    sqrt_less_than_one:
    // x < 1: initial guess = 1.0
    pop [ONE_FP128]                     // [guess=1.0, x]
    
    sqrt_iterate:
    // Stack: [guess, x]
    // Perform 7 Newton-Raphson iterations: guess = (guess + x/guess) / 2
    
    // Iteration 1
    dup2 dup2 FP128_DIV()               // [x/guess, guess, x]
    add 0x01 shr                        // [new_guess, x]
    
    // Iteration 2
    dup2 dup2 FP128_DIV()               // [x/guess, guess, x]
    add 0x01 shr                        // [new_guess, x]
    
    // Iteration 3
    dup2 dup2 FP128_DIV()               // [x/guess, guess, x]
    add 0x01 shr                        // [new_guess, x]
    
    // Iteration 4
    dup2 dup2 FP128_DIV()               // [x/guess, guess, x]
    add 0x01 shr                        // [new_guess, x]
    
    // Iteration 5
    dup2 dup2 FP128_DIV()               // [x/guess, guess, x]
    add 0x01 shr                        // [new_guess, x]
    
    // Iteration 6
    dup2 dup2 FP128_DIV()               // [x/guess, guess, x]
    add 0x01 shr                        // [new_guess, x]
    
    // Iteration 7 (final)
    dup2 dup2 FP128_DIV()               // [x/guess, guess, x]
    add 0x01 shr                        // [result, x]
    
    swap1 pop                           // [result]
    sqrt_done jump

    sqrt_zero:
    sqrt_done:
}
