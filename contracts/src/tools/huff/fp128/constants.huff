// Stage 7: threshold = 2^(1/128), multiplier = 2^(-1/128)
#define constant LOG2_RT7 = 0x000000000000000000000000000000010163da9fb33356d84a66ae336dcdfa40
#define constant LOG2_INV_RT7 = 0x00000000000000000000000000000000fe9e115c7b8f884badd25995e79d2f09

// ============================================================================
// EXP10 Overflow/Underflow Thresholds
// ============================================================================

// EXP10_OVERFLOW_THRESHOLD: 38 in FP128 format (10^38 ~ 2^126)
#define constant EXP10_OVERFLOW_THRESHOLD = 0x0000000000000000000000000000002600000000000000000000000000000000
// EXP10_UNDERFLOW_THRESHOLD: -38 in FP128 format (10^-38 underflows)
#define constant EXP10_UNDERFLOW_THRESHOLD = 0xffffffffffffffffffffffffffffffda00000000000000000000000000000000

