/// @title FixedPoint128 Constants
/// @notice Constants for signed fixed-point arithmetic using two's complement
/// @dev Format: 128 integer bits + 128 fractional bits in a single uint256
///      Value represented = word / 2^128
///      Sign handled via two's complement (bit 255 is sign bit)

// FRAC_BITS: Number of fractional bits (128)
#define constant FRAC_BITS = 0x80

// HALF_FRAC_BITS: Half of fractional bits (64) - used for chunked division
#define constant HALF_FRAC_BITS = 0x40

// ONE_FP128: The value 1.0 in 128.128 format (1 << 128)
#define constant ONE_FP128 = 0x100000000000000000000000000000000

// FIXED18_SCALE: 10^18 (for converting to/from 18-decimal fixed-point)
#define constant FIXED18_SCALE = 0xDE0B6B3A7640000

// MASK128: Mask for lower 128 bits (2^128 - 1)
#define constant MASK128 = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF

// ============================================================================
// Transcendental Function Constants
// ============================================================================
// Generated by scripts/generate_fp128_coefficients.py
// Adapted from Remco Bloemen's Solady implementation

// LN2_FP128: ln(2) in 128.128 format
#define constant LN2_FP128 = 0x00000000000000000000000000000000b17217f7d1cf79abc9e3b39803f2f6af

// INV_LN2_FP128: 1/ln(2) in 128.128 format
#define constant INV_LN2_FP128 = 0x0000000000000000000000000000000171547652b82fe1777d0ffda0d23a7d11

// EXP_OVERFLOW_THRESHOLD: max input for exp (88.0 in 128.128)
#define constant EXP_OVERFLOW_THRESHOLD = 0x0000000000000000000000000000005800000000000000000000000000000000

// EXP_UNDERFLOW_THRESHOLD: min input for exp (-88.0 in 128.128)
#define constant EXP_UNDERFLOW_THRESHOLD = 0xffffffffffffffffffffffffffffffa800000000000000000000000000000000

