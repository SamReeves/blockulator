// ============================================================================
// LOG2 Range-Reduction Constants
// ============================================================================
// Thresholds and multipliers for 7-stage range reduction
// Generated by scripts/generators/generate_log2_range_constants.py

// Stage 1: threshold = sqrt(2) (use SQRT2_FP128), multiplier = 1/sqrt(2)
#define constant LOG2_INV_RT1 = 0x00000000000000000000000000000000b504f333f9de6484597d89b3754abe9f

// Stage 2: threshold = 2^(1/4), multiplier = 2^(-1/4)
#define constant LOG2_RT2 = 0x00000000000000000000000000000001306fe0a31b7152de8d5a46305c85edec
#define constant LOG2_INV_RT2 = 0x00000000000000000000000000000000d744fccad69d6af439a68bb9902d3fde

// Stage 3: threshold = 2^(1/8), multiplier = 2^(-1/8)
#define constant LOG2_RT3 = 0x00000000000000000000000000000001172b83c7d517adcdf7c8c50eb14a7920
#define constant LOG2_INV_RT3 = 0x00000000000000000000000000000000eac0c6e7dd24392ed02d75b3706e54fa

// Stage 4: threshold = 2^(1/16), multiplier = 2^(-1/16)
#define constant LOG2_RT4 = 0x000000000000000000000000000000010b5586cf9890f6298b92b71842a98364
#define constant LOG2_INV_RT4 = 0x00000000000000000000000000000000f5257d152486cc2c7b9d0c7aed980fc3

// Stage 5: threshold = 2^(1/32), multiplier = 2^(-1/32)
#define constant LOG2_RT5 = 0x00000000000000000000000000000001059b0d31585743ae7c548eb68ca417fe
#define constant LOG2_INV_RT5 = 0x00000000000000000000000000000000fa83b2db722a033a7c25bb14315d7fcc

// Stage 6: threshold = 2^(1/64), multiplier = 2^(-1/64)
