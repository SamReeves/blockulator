/// @title FixedPoint128 - 128.128 Fixed-Point Arithmetic Library
/// @notice Signed fixed-point operations using two's complement
/// @dev Format: 128 integer bits + 128 fractional bits
///      All operations preserve sign via two's complement

#include "fixedpoint128_constants.huff"

/// @notice Add two 128.128 fixed-point numbers
/// @dev takes(2) returns(1)
/// Stack input: [a, b]
/// Stack output: [a + b]
#define macro FP128_ADD() = takes(2) returns(1) {
    add
}

/// @notice Subtract two 128.128 fixed-point numbers
/// @dev takes(2) returns(1)
/// Stack input: [a, b] (b on top)
/// Stack output: [a - b]
#define macro FP128_SUB() = takes(2) returns(1) {
    swap1     // [a, b] -> [b, a]
    sub       // b - a
}

/// @notice Convert signed fixed18 to 128.128 format
/// @dev takes(1) returns(1)
/// Stack input: [fixed18_value] (signed int256 representing value * 1e18)
/// Stack output: [fp128_value] (signed int256 representing value * 2^128)
/// Formula: fp128 = (fixed18 * 2^128) / 1e18
/// Gas: ~100 (optimized)
#define macro FP128_FROM_FIXED18() = takes(1) returns(1) {
    // Input: [fixed18]
    // We need: (fixed18 * 2^128) / 1e18
    // For typical calculator use (values up to ~10^20), we're safe:
    // 10^20 * 2^128 ≈ 2^195, well within 256 bits.
    
    0x80 shl              // [fixed18 << 128] (PUSH1 + SHL = 6 gas)
    [FIXED18_SCALE]       // [1e18, fixed18 << 128]
    swap1 sdiv            // [result] (minimized stack ops)
}

/// @notice Convert 128.128 format to signed fixed18
/// @dev takes(1) returns(1)
/// Stack input: [fp128_value] (signed int256 representing value * 2^128)
/// Stack output: [fixed18_value] (signed int256 representing value * 1e18)
/// Formula: fixed18 = (fp128 * 1e18) / 2^128
///          Use arithmetic right shift to preserve sign
/// Gas: ~100 (optimized)
#define macro FP128_TO_FIXED18() = takes(1) returns(1) {
    // Input: [fp128]
    // We need: (fp128 * 1e18) >> 128
    // Use signed operations to preserve sign
    
    [FIXED18_SCALE] mul   // [fp128 * 1e18]
    0x80 sar              // [result] (PUSH1 + SAR = 6 gas)
}

/// @notice Multiply two 128.128 fixed-point numbers (FAST VERSION - omits Term4)
/// @dev takes(2) returns(1)
/// Stack input: [b, a] (b on top)
/// Stack output: [a * b]
/// Formula: result = (a * b) / 2^128 (3-term approximation, omits Term4)
///          Trades 1 ULP max precision for ~15 gas savings
/// Gas: ~125-140 (15 gas less than FP128_MUL)
/// Precision: 37+ decimal digits average (1 ULP max error)
#define macro FP128_MUL_FAST() = takes(2) returns(1) {
    // Input: [b, a]
    // Split both: a = a_hi * 2^128 + a_lo, b = b_hi * 2^128 + b_lo
    // Result = a_hi * b_hi * 2^128 + a_hi * b_lo + a_lo * b_hi
    // (Term4 omitted: (a_lo * b_lo) >> 128 contributes at most 1 ULP)
    
    // Term1: (a_hi * b_hi) << 128
    dup2 0x80 sar         // [a_hi, b, a]
    dup2 0x80 sar         // [b_hi, a_hi, b, a]
    mul                   // [a_hi*b_hi, b, a]
    0x80 shl              // [term1, b, a]
    
    // Term2: a_hi * b_lo
    dup3 0x80 sar         // [a_hi, term1, b, a]
    dup3 [MASK128] and    // [b_lo, a_hi, term1, b, a]
    mul                   // [a_hi*b_lo, term1, b, a]
    add                   // [sum12, b, a]
    
    // Term3: a_lo * b_hi
    dup3 [MASK128] and    // [a_lo, sum12, b, a]
    dup3 0x80 sar         // [b_hi, a_lo, sum12, b, a]
    mul                   // [a_lo*b_hi, sum12, b, a]
    add                   // [result, b, a]
    
    // Clean stack
    swap2 pop pop         // [result]
}

/// @notice Multiply two 128.128 fixed-point numbers
/// @dev takes(2) returns(1)
/// Stack input: [b, a] (b on top)
/// Stack output: [a * b]
/// Formula: result = (a * b) / 2^128
///          Inline extraction - compute each term directly from a and b
/// Gas: ~140-160 (optimized: no pre-extraction, minimal cleanup)
#define macro FP128_MUL() = takes(2) returns(1) {
    // Input: [b, a]
    // Split both: a = a_hi * 2^128 + a_lo, b = b_hi * 2^128 + b_lo
    // Result = a_hi * b_hi * 2^128 + a_hi * b_lo + a_lo * b_hi + (a_lo * b_lo) >> 128
    // Inline extraction: compute each term directly without pre-extracting all parts
    
    // Term1: (a_hi * b_hi) << 128
    // Stack: [b, a]
    dup2 0x80 sar         // [a_hi, b, a]
    dup2 0x80 sar         // [b_hi, a_hi, b, a]
    mul                   // [a_hi*b_hi, b, a]
    0x80 shl              // [term1, b, a]
    
    // Term2: a_hi * b_lo
    // Stack: [term1, b, a]
    dup3 0x80 sar         // [a_hi, term1, b, a]
    dup3 [MASK128] and    // [b_lo, a_hi, term1, b, a]
    mul                   // [a_hi*b_lo, term1, b, a]
    add                   // [sum12, b, a]
    
    // Term3: a_lo * b_hi
    // Stack: [sum12, b, a]
    dup3 [MASK128] and    // [a_lo, sum12, b, a]
    dup3 0x80 sar         // [b_hi, a_lo, sum12, b, a]
    mul                   // [a_lo*b_hi, sum12, b, a]
    add                   // [sum123, b, a]
    
    // Term4: (a_lo * b_lo) >> 128
    // Stack: [sum123, b, a]
    dup3 [MASK128] and    // [a_lo, sum123, b, a]
    dup3 [MASK128] and    // [b_lo, a_lo, sum123, b, a]
    mul                   // [a_lo*b_lo, sum123, b, a]
    0x80 shr              // [(a_lo*b_lo)>>128, sum123, b, a]
    add                   // [result, b, a]
    
    // Clean stack: only 2 items to remove
    swap2 pop pop         // [result]
}

/// @notice Divide two 128.128 fixed-point numbers
/// @dev takes(2) returns(1)
/// Stack input: [b, a] (b on top)
/// Stack output: [a / b]
/// Formula: result = (a * 2^128) / b
///          Use 64-bit chunked shift-and-divide (2 steps)
/// Gas: ~400-450 (optimized with 0x40 constant)
/// Precision: ~62 bits (acceptable trade-off for gas efficiency)
#define macro FP128_DIV() = takes(2) returns(1) {
    // Input: [b, a]
    // We want: (a * 2^128) / b = (a << 128) / b
    // Problem: a << 128 overflows 256 bits
    // Solution: Shift by 64 bits at a time, divide after each shift
    //   Step 1: q1 = (a << 64) / b,  r1 = (a << 64) % b
    //   Step 2: q2 = (r1 << 64) / b
    //   Result: (q1 << 64) + q2
    //
    // Note: This loses ~64 bits of precision because q2 is truncated.
    // For full precision, would need Solady-style mulDiv (~800-1000 gas)
    
    swap1                      // [a, b]
    0x40 shl                   // [a << 64, b]
    dup1 dup3 swap1 sdiv       // [q1, a<<64, b]
    swap2                      // [b, a<<64, q1]
    dup1 swap2 smod            // [r1, b, q1]
    0x40 shl                   // [r1 << 64, b, q1]
    swap1 sdiv                 // [q2, q1]
    swap1 0x40 shl             // [q1 << 64, q2]
    add                        // [result]
}
