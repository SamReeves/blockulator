/// @title Simple Hex Test
/// @notice Ultra-simple test to debug packing

#include "hex_fp_constants.huff"

/// Simple pack test
#define macro SIMPLE_PACK() = takes(0) returns(1) {
    // Create test values
    0x10000000000000000      // mantissa = 2^64
    0x40                      // exponent = 64
    0x00                      // sign = 0
    
    // Pack manually inline
    // mantissa & MANTISSA_MASK
    swap2
    [MANTISSA_MASK] and
    
    // exponent << 247
    swap1
    [EXP_MASK] and
    [EXP_SHIFT] shl
    or
    
    // sign << 255
    swap1
    [SIGN_BIT] shl
    or
}

#define macro MAIN() = takes(0) returns(0) {
    0x00 calldataload 0xe0 shr
    
    dup1 __FUNC_SIG(test) eq test_jump jumpi
    
    0x00 0x00 revert
    
    test_jump:
        pop
        SIMPLE_PACK()
        0x00 mstore
        0x20 0x00 return
}

#define function test() pure returns (uint256)
