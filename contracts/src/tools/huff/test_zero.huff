/// Test e^0 = 1

#define macro MAIN() = takes(0) returns(0) {
    0x00 calldataload 0xe0 shr
    
    dup1 0xb9d92de8 eq calculate_jump jumpi
    0x00 0x00 revert
    
    calculate_jump:
        pop
        0x04 calldataload    // [x_fixed18]
        
        // Check if zero
        dup1 iszero is_zero jumpi
        
        // Non-zero path: return 2e18 for now
        pop
        0x1bc16d674ec80000  // 2e18
        0x00 mstore
        0x20 0x00 return
        
        is_zero:
            pop
            0xde0b6b3a7640000  // 1e18
            0x00 mstore
            0x20 0x00 return
}

#define function calculate(uint256) pure returns (uint256)
