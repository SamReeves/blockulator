/// Test scaled multiply

#include "fp_constants.huff"
#include "tables/exp_table.huff"

#define macro MAIN() = takes(0) returns(0) {
    0x00 calldataload 0xe0 shr
    
    dup1 0x8dfa4363 eq calculate_jump jumpi
    dup1 0x1a03d3d7 eq get_factor jumpi
    0x00 0x00 revert
    
    calculate_jump:
        pop
        // Get two args: a and b, return (a * b) / SCALE
        0x04 calldataload
        0x24 calldataload
        mul
        [SCALE] div
        0x00 mstore
        0x20 0x00 return
    
    get_factor:
        pop
        // Return TABLE[0][1] (e^1)
        0x00 0x01
        EXP_TABLE_LOOKUP()
        0x00 mstore
        0x20 0x00 return
}

#define function calculate(uint256,uint256) pure returns (uint256)
#define function get_factor() pure returns (uint256)
