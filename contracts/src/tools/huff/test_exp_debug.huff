/// Debug version of exp to check intermediate values

#include "fp_constants.huff"
#include "tables/exp_table.huff"

#define macro MAIN() = takes(0) returns(0) {
    0x00 calldataload 0xe0 shr
    
    dup1 0xb9d92de8 eq calculate_jump jumpi
    dup1 0x1a03d3d7 eq debug_jump jumpi
    0x00 0x00 revert
    
    calculate_jump:
        pop
        0x04 calldataload
        dup1 iszero is_zero jumpi
        
        // Convert to scaled36
        [FIXED18_SCALE] mul
        
        // Initialize
        [SCALE] swap1 0x00
        
        // Just do ONE iteration and return y
        dup2 [SCALE] div      // d = x / SCALE
        dup1 dup3             // [i, d]
        EXP_TABLE_LOOKUP()    // [factor]
        
        // Return factor for debugging
        0x00 mstore
        0x20 0x00 return
        
        is_zero:
            pop
            [FIXED18_SCALE]
            0x00 mstore
            0x20 0x00 return
    
    debug_jump:
        pop
        // Return SCALE for verification
        [SCALE]
        0x00 mstore
        0x20 0x00 return
}

#define function calculate(uint256) pure returns (uint256)
#define function debug_scale() pure returns (uint256)
