/// Test to check loop intermediate values

#include "fp_constants.huff"
#include "tables/exp_table.huff"

#define macro MAIN() = takes(0) returns(0) {
    0x00 calldataload 0xe0 shr
    
    dup1 0xb9d92de8 eq calculate_jump jumpi
    0x00 0x00 revert
    
    calculate_jump:
        pop
        0x04 calldataload
        
        // Convert to scaled36
        [FIXED18_SCALE] mul
        
        // y = SCALE
        [SCALE] swap1 0x00
        
        // ONE iteration only
        // Stack: [i=0, x, y]
        dup2 [SCALE] swap1 div      // [d, i, x, y]
        dup1 dup3                   // [i, d, d, i, x, y]
        EXP_TABLE_LOOKUP()          // [factor, d, i, x, y]
        
        // y = (y * factor) / SCALE
        dup5 mul [SCALE] swap1 div  // [y', d, i, x, y]
        swap4 pop                   // [y', d, i, x]
        
        // Return y' (after one multiplication)
        0x00 mstore
        0x20 0x00 return
}

#define function calculate(uint256) pure returns (uint256)
