/// @title Micro-tests for FP_NORMALIZE debugging
/// @notice Minimal test contract to isolate individual EVM operations
/// @dev Each function tests ONE atomic operation with real EVM execution

#include "binary256_constants.huff"

#define macro MAIN() = takes(0) returns(0) {
    0x00 calldataload 0xe0 shr
    
    dup1 __FUNC_SIG(identity) eq identity_jump jumpi
    dup1 __FUNC_SIG(testLt) eq testLt_jump jumpi
    dup1 __FUNC_SIG(testImplicitBit) eq testImplicitBit_jump jumpi
    dup1 __FUNC_SIG(testSigLtImplicit) eq testSigLtImplicit_jump jumpi
    dup1 __FUNC_SIG(shiftLeft1) eq shiftLeft1_jump jumpi
    dup1 __FUNC_SIG(shiftRight1) eq shiftRight1_jump jumpi
    dup1 __FUNC_SIG(subtractImplicit) eq subtractImplicit_jump jumpi
    dup1 __FUNC_SIG(testSubtract) eq testSubtract_jump jumpi
    dup1 __FUNC_SIG(normalizeOnce) eq normalizeOnce_jump jumpi
    
    0x00 0x00 revert
    
    identity_jump:
        pop
        // Return both inputs unchanged
        0x04 calldataload      // [a]
        0x24 calldataload      // [b, a]
        0x20 mstore            // [a] (b stored at 0x20)
        0x00 mstore            // [] (a stored at 0x00)
        0x40 0x00 return       // Return 64 bytes: [a at 0x00, b at 0x20]
    
    testLt_jump:
        pop
        // Return a < b (EVM lt opcode: pops [b, a] and returns a < b)
        0x04 calldataload      // [a]
        0x24 calldataload      // [b, a]
        swap1                   // [a, b]
        lt                      // [a < b]
        0x00 mstore
        0x20 0x00 return
    
    testImplicitBit_jump:
        pop
        // Return the value of IMPLICIT_BIT constant
        [IMPLICIT_BIT]         // [IMPLICIT_BIT]
        0x00 mstore
        0x20 0x00 return
    
    testSigLtImplicit_jump:
        pop
        // Return sig < IMPLICIT_BIT (EVM lt: pops [b, a] and returns a < b)
        0x04 calldataload      // [sig]
        dup1                    // [sig, sig]
        [IMPLICIT_BIT]         // [IMPLICIT_BIT, sig, sig]
        swap1                   // [sig, IMPLICIT_BIT, sig]
        lt                      // [sig < IMPLICIT_BIT, sig]
        swap1 pop              // [sig < IMPLICIT_BIT]
        0x00 mstore
        0x20 0x00 return
    
    shiftLeft1_jump:
        pop
        // Return (sig << 1, exp - 1)
        // Read inputs
        0x04 calldataload      // [sig]
        0x24 calldataload      // [exp, sig]
        
        // Compute sig << 1
        swap1                   // [sig, exp]
        0x01 shl               // [sig << 1, exp]
        
        // Compute exp - 1 (EVM sub: pops [top, next], returns top - next)
        // Need stack [exp, 0x01, ...] so sub computes exp - 1
        swap1                   // [exp, sig << 1]
        0x01 swap1 sub         // [0x01, exp, sig << 1] → [exp, 0x01, sig << 1] → [exp - 1, sig << 1]
        
        // Store: want (sig << 1) at 0x00, (exp - 1) at 0x20
        // Stack: [exp - 1, sig << 1]
        swap1                   // [sig << 1, exp - 1]
        
        // Store sig << 1 at 0x00
        dup1 0x00 mstore       // [sig << 1, exp - 1]
        
        // Store exp - 1 at 0x20
        swap1 0x20 mstore      // [sig << 1]
        pop
        
        0x40 0x00 return
    
    shiftRight1_jump:
        pop
        // Return (sig >> 1, exp + 1)
        0x04 calldataload      // [sig]
        0x24 calldataload      // [exp, sig]
        swap1 0x01 shr         // [sig >> 1, exp]
        
        // Compute exp + 1 (EVM add: pops [a, b], returns a + b)
        swap1 0x01 add         // [exp + 1, sig >> 1]
        
        // Store results: (sig >> 1) at 0x00, (exp + 1) at 0x20
        swap1                   // [sig >> 1, exp + 1]
        dup1 0x00 mstore       // [sig >> 1, exp + 1]
        swap1 0x20 mstore      // [sig >> 1]
        pop
        
        0x40 0x00 return
    
    subtractImplicit_jump:
        pop
        // Return sig - IMPLICIT_BIT (EVM sub: pops [top, next], returns top - next)
        0x04 calldataload      // [sig]
        [IMPLICIT_BIT] swap1   // [sig, IMPLICIT_BIT]
        sub                     // [sig - IMPLICIT_BIT]
        0x00 mstore
        0x20 0x00 return
    
    testSubtract_jump:
        pop
        // Test basic subtraction: a - b (EVM sub: pops [a, b], returns b - a)
        0x04 calldataload      // [a]
        0x24 calldataload      // [b, a]
        sub                     // [a - b]
        0x00 mstore
        0x20 0x00 return
    
    normalizeOnce_jump:
        pop
        // Do ONE iteration of the normalize loop
        // Input: (sig, exp)
        // Output: (new_sig, new_exp, done_flag)
        //   done_flag: 0 = need more iterations, 1 = normalized, 2 = zero
        0x04 calldataload      // [sig]
        0x24 calldataload      // [exp, sig]
        swap1                   // [sig, exp]
        
        // Check if zero
        dup1 iszero normalize_once_zero jumpi
        
        // Check if sig < IMPLICIT_BIT (need shift left)
        dup1 [IMPLICIT_BIT]    // [IMPLICIT_BIT, sig, exp]
        swap1                   // [sig, IMPLICIT_BIT, exp]
        lt normalize_once_shift_left jumpi
        
        // Check if sig >= 2*IMPLICIT_BIT (need shift right)
        dup1 [IMPLICIT_BIT] dup1 add  // [2^237, sig, exp]
        swap1                          // [sig, 2^237, exp]
        lt iszero normalize_once_shift_right jumpi
        
        // Already normalized! Remove implicit bit and return done=1
        [IMPLICIT_BIT] swap1 sub  // [sig - IMPLICIT_BIT, exp]
        0x01                       // [done=1, sig - IMPLICIT_BIT, exp]
        swap1 0x00 mstore         // [done=1, exp] (sig stored at 0x00)
        swap1 0x20 mstore         // [done=1] (exp stored at 0x20)
        0x40 mstore               // [] (done stored at 0x40)
        0x60 0x00 return
        
    normalize_once_shift_left:
        // Shift left once: (sig << 1, exp - 1, done=0)
        0x01 shl               // [sig << 1, exp]
        swap1 0x01 swap1 sub   // [exp - 1, sig << 1]
        swap1                   // [sig << 1, exp - 1]
        0x00                    // [done=0, sig << 1, exp - 1]
        swap1 0x00 mstore      // [done=0, exp - 1]
        swap1 0x20 mstore      // [done=0]
        0x40 mstore            // []
        0x60 0x00 return
        
    normalize_once_shift_right:
        // Shift right once: (sig >> 1, exp + 1, done=0)
        0x01 shr               // [sig >> 1, exp]
        swap1 0x01 add         // [exp + 1, sig >> 1]
        swap1                   // [sig >> 1, exp + 1]
        0x00                    // [done=0, sig >> 1, exp + 1]
        swap1 0x00 mstore      // [done=0, exp + 1]
        swap1 0x20 mstore      // [done=0]
        0x40 mstore            // []
        0x60 0x00 return
        
    normalize_once_zero:
        // Zero input: return (0, 0, done=2)
        pop pop                 // []
        0x00 0x00 mstore       // [] (sig=0 at 0x00)
        0x00 0x20 mstore       // [] (exp=0 at 0x20)
        0x02 0x40 mstore       // [] (done=2 at 0x40)
        0x60 0x00 return
}

#define function identity(uint256,uint256) pure returns (uint256,uint256)
#define function testLt(uint256,uint256) pure returns (uint256)
#define function testImplicitBit() pure returns (uint256)
#define function testSigLtImplicit(uint256) pure returns (uint256)
#define function shiftLeft1(uint256,uint256) pure returns (uint256,uint256)
#define function shiftRight1(uint256,uint256) pure returns (uint256,uint256)
#define function subtractImplicit(uint256) pure returns (uint256)
#define function testSubtract(uint256,uint256) pure returns (uint256)
#define function normalizeOnce(uint256,uint256) pure returns (uint256,uint256,uint256)
