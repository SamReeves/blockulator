/// Test pushing SCALE

#define constant SCALE = 0xC097CE7BC90715B34B9F1000000000

#define macro MAIN() = takes(0) returns(0) {
    0x00 calldataload 0xe0 shr
    
    dup1 0xb9d92de8 eq calculate_jump jumpi
    0x00 0x00 revert
    
    calculate_jump:
        pop
        [SCALE]
        0x00 mstore
        0x20 0x00 return
}

#define function calculate(uint256) pure returns (uint256)
