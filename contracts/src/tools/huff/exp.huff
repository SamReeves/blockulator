/// @title Exponential Function Calculator
/// @notice High-precision e**x using scaled-integer arithmetic
/// @dev Product-rule with loop: e**x = product(e**(d_i * 10**(-i))) for i=0..18
/// @dev Uses SCALE = 10^36 for 36-digit internal precision, 18-digit output

#include "fp_constants.huff"
#include "tables/exp_table.huff"

/// @notice Calculate e**x using 19-iteration product-rule (loop-based)
/// @dev takes(1) returns(1)
/// Stack input: [x_fixed18]  (18-decimal fixed-point)
/// Stack output: [result_fixed18]
///
/// Algorithm (scaled integer, no FP packing):
///   x = x_fixed18 * 10^18  (convert to 36-digit scale)
///   y = 10^36              (1.0 in scaled form)
///   for i in 0..18:
///     d = x / 10^36        (extract leading digit)
///     factor = TABLE[i][d] (lookup scaled value)
///     y = (y * factor) / 10^36
///     x = (x - d * 10^36) * 10
///   return y / 10^18       (convert back to fixed18)
///
/// Loop uses memory at 0x00 to store y, stack only has [i, x]
#define macro EXP() = takes(1) returns(1) {
    dup1 iszero exp_is_zero jumpi

    // Convert fixed18 to scaled36: x = x_fixed18 * 10^18
    [FIXED18_SCALE] mul       // [x_scaled36]

    // Store y = SCALE (1.0) in memory
    [SCALE] 0x00 mstore       // []

    // Stack: [x]
    0x00                      // [i=0, x]

    exp_loop:
        // Stack: [i, x]

        // d = x / SCALE (extract leading digit 0-9)
        dup2                        // [x, i, x]
        [SCALE] swap1 div           // [d, i, x]

        // factor = TABLE[i][d]
        dup1 dup3                   // [i, d, d, i, x]
        EXP_TABLE_LOOKUP()          // [factor, d, i, x]

        // y = (y * factor) / SCALE (load from memory, multiply, store back)
        0x00 mload                  // [y, factor, d, i, x]
        swap1                       // [factor, y, d, i, x]
        mul                         // [y * factor, d, i, x]
        [SCALE]                     // [SCALE, y*factor, d, i, x]
        swap1                       // [y*factor, SCALE, d, i, x]
        div                         // [y_new, d, i, x]
        0x00 mstore                 // [d, i, x]

        // x = (x - d * SCALE) * 10
        [SCALE] mul                 // [d * SCALE, i, x]
        dup3 sub                    // [x - d*SCALE, i, x]
        [TEN] mul                   // [x_new, i, x]
        swap2 pop                   // [i, x_new] (remove old x)

        // i++; loop while i < 19
        0x01 add                    // [i+1, x_new]
        dup1 0x13 swap1 lt exp_loop jumpi

        // Loop done: [i, x]
        pop pop                     // []
        0x00 mload                  // [y]
        [FIXED18_SCALE] swap1 div   // [result_fixed18]
        exp_done jump

    exp_is_zero:
        pop
        [FIXED18_SCALE]       // 1.0 in fixed18

    exp_done:
}

/// @notice Main contract entry point with ABI routing
#define macro MAIN() = takes(0) returns(0) {
    0x00 calldataload 0xe0 shr

    dup1 __FUNC_SIG(calculate) eq calculate_jump jumpi
    dup1 __FUNC_SIG(get_constant) eq constant_jump jumpi
    0x00 0x00 revert

    calculate_jump:
        pop
        0x04 calldataload
        EXP()
        0x00 mstore
        0x20 0x00 return

    constant_jump:
        pop
        // e * 1e18 = 2718281828459045235
        0x25b946ebc0b36173
        0x00 mstore
        0x20 0x00 return
}

#define function calculate(uint256) nonpayable returns (uint256)
#define function get_constant() pure returns (uint256)
