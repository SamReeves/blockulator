/// Test exp with detailed tracing

#include "fp_constants.huff"
#include "tables/exp_table.huff"

#define macro MAIN() = takes(0) returns(0) {
    0x00 calldataload 0xe0 shr
    
    dup1 0xb9d92de8 eq calculate_jump jumpi
    dup1 0x97122b5a eq get_y jumpi
    dup1 0x1a03d3d7 eq get_i jumpi
    0x00 0x00 revert
    
    calculate_jump:
        pop
        0x04 calldataload
        [FIXED18_SCALE] mul
        
        // y at 0x00, iteration count at 0x20
        [SCALE] 0x00 mstore
        0x00 0x20 mstore
        
        0x00  // [i=0, x]
        
        loop:
            // Increment iteration counter
            0x20 mload 0x01 add 0x20 mstore
            
            // d = x / SCALE
            dup2 [SCALE] swap1 div
            
            // factor = TABLE[i][d]
            dup2 dup2
            EXP_TABLE_LOOKUP()
            
            // y = (y * factor) / SCALE
            0x00 mload swap1 mul [SCALE] swap1 div
            0x00 mstore
            
            // x = (x - d * SCALE) * 10
            [SCALE] mul dup3 sub [TEN] mul
            swap2 pop swap1
            
            // i++; loop while i < 19
            0x01 add
            dup1 0x13 swap1 lt loop jumpi
        
        // Return final y
        pop pop
        0x00 mload
        [FIXED18_SCALE] swap1 div
        0x00 mstore
        0x20 0x00 return
    
    get_y:
        pop
        0x00 mload
        0x00 mstore
        0x20 0x00 return
    
    get_i:
        pop
        0x20 mload
        0x00 mstore
        0x20 0x00 return
}

#define function calculate(uint256) pure returns (uint256)
#define function get_y() view returns (uint256)
#define function get_i() view returns (uint256)
