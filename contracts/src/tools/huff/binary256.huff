/// @title IEEE 754 binary256 Floating-Point Arithmetic Library
/// @notice Binary floating-point operations using IEEE 754 octuple-precision format
/// @dev Format: 1-bit sign + 19-bit exponent + 236-bit significand
///      Following IEEE 754-2008 binary256 (octuple precision) specification

#include "binary256_constants.huff"

// ============================================================================
// HELPER MACROS
// ============================================================================

/// @notice Extract sign, exponent, and significand from packed binary256 float
/// @dev takes(1) returns(3)
/// Stack input: [packed]
/// Stack output: [significand, exponent, sign]
#define macro FP_UNPACK() = takes(1) returns(3) {
    // Input: [packed]
    dup1                        // [packed, packed]
    [SIGN_BIT] shr             // [sign, packed]
    swap1                       // [packed, sign]
    
    dup1                        // [packed, packed, sign]
    [EXP_SHIFT] shr            // [exp_field, packed, sign]
    [EXP_MASK] and             // [exponent, packed, sign]
    swap1                       // [packed, exponent, sign]
    
    [SIGNIFICAND_MASK] and     // [significand, exponent, sign]
}

/// @notice Check if packed value is zero (+0 or -0)
/// @dev takes(1) returns(2)  Stack: [packed] -> [packed, is_zero (0|1)]
#define macro FP_IS_ZERO() = takes(1) returns(2) {
    dup1                         // [packed, packed]
    FP_UNPACK()                  // [sig, exp, sign, packed]
    dup2 iszero                  // [exp==0, sig, exp, sign, packed]
    swap1 iszero                 // [sig==0, exp==0, exp, sign, packed]
    and                          // [is_zero, exp, sign, packed]
    pop pop pop                  // [is_zero, packed]
    swap1                        // [packed, is_zero]
}

/// @notice Check if packed value is subnormal (exp=0, sig!=0)
/// @dev takes(1) returns(2)  Stack: [packed] -> [packed, is_subnormal (0|1)]
#define macro FP_IS_SUBNORMAL() = takes(1) returns(2) {
    dup1                         // [packed, packed]
    FP_UNPACK()                  // [sig, exp, sign, packed]
    dup2 iszero                  // [exp==0, sig, exp, sign, packed]
    swap1 iszero iszero          // [sig!=0, exp==0, exp, sign, packed]
    and                          // [is_subnormal, exp, sign, packed]
    pop pop pop                  // [is_subnormal, packed]
    swap1                        // [packed, is_subnormal]
}

/// @notice Check if packed value is infinite (exp=0x7FFFF, sig=0)
/// @dev takes(1) returns(2)  Stack: [packed] -> [packed, is_inf (0|1)]
#define macro FP_IS_INFINITE() = takes(1) returns(2) {
    dup1                         // [packed, packed]
    FP_UNPACK()                  // [sig, exp, sign, packed]
    dup2 [EXP_INF_NAN] eq        // [exp==0x7FFFF, sig, exp, sign, packed]
    swap1 iszero                 // [sig==0, exp==0x7FFFF, exp, sign, packed]
    and                          // [is_inf, exp, sign, packed]
    pop pop pop                  // [is_inf, packed]
    swap1                        // [packed, is_inf]
}

/// @notice Check if packed value is NaN (exp=0x7FFFF, sig!=0)
/// @dev takes(1) returns(2)  Stack: [packed] -> [packed, is_nan (0|1)]
#define macro FP_IS_NAN() = takes(1) returns(2) {
    dup1
    FP_UNPACK()                  // [sig, exp, sign, packed]
    dup2 [EXP_INF_NAN] eq        // [exp==0x7FFFF, sig, exp, sign, packed]
    swap1 iszero iszero          // [sig!=0, exp==0x7FFFF, exp, sign, packed]
    and                          // [is_nan, exp, sign, packed]
    pop pop pop
    swap1                        // [packed, is_nan]
}

/// @notice Pack sign, exponent, and significand into binary256 float word
/// @dev takes(3) returns(1)
/// Stack input: [significand, exponent, sign]
/// Stack output: [packed]
#define macro FP_PACK() = takes(3) returns(1) {
    // Input: [significand, exponent, sign]
    //  bits [255]     : sign
    //  bits [254:236] : exponent (19 bits)
    //  bits [235:0]   : significand (236 bits)
    
    // Start with significand (limit to 236 bits)
    [SIGNIFICAND_MASK] and     // [sig & mask, exponent, sign]
    
    // Add exponent field
    swap1                       // [exponent, sig, sign]
    [EXP_MASK] and             // [exp & 0x7FFFF, sig, sign]
    [EXP_SHIFT] shl            // [exp_field << 236, sig, sign]
    or                          // [sig|exp, sign]
    
    // Add sign bit
    swap1                       // [sign, sig|exp]
    [SIGN_BIT] shl             // [sign << 255, sig|exp]
    or                          // [packed]
}

/// @notice Normalize significand using binary CLZ (count leading zeros)
/// @dev takes(2) returns(2)
/// Stack input: [significand, exponent]
/// Stack output: [normalized_significand, adjusted_exponent]
/// Uses binary search to find leading bit in O(log n) instead of O(n) loop
#define macro FP_NORMALIZE() = takes(2) returns(2) {
    // Input: [sig, exp]
    // Output: [normalized_sig (implicit bit removed), adjusted_exp]
    
    // Check if significand is zero
    dup1 iszero normalize_zero jumpi

    // Binary search CLZ: test 128-bit, 64-bit, 32-bit, 16-bit, 8-bit, 4-bit, 2-bit, 1-bit
    // At each step: if (sig & MASK) == 0, shift left by that amount and adjust exp
    
    // Test 128-bit: if top 128 bits are zero, shift left 128
    dup1 [MASK_128] and            // [sig & MASK_128, sig, exp]
    iszero normalize_shift_128 jumpi
    normalize_skip_128:
    
    // Test 64-bit
    dup1 [MASK_64] and
    iszero normalize_shift_64 jumpi
    normalize_skip_64:
    
    // Test 32-bit
    dup1 [MASK_32] and
    iszero normalize_shift_32 jumpi
    normalize_skip_32:
    
    // Test 16-bit
    dup1 [MASK_16] and
    iszero normalize_shift_16 jumpi
    normalize_skip_16:
    
    // Test 8-bit
    dup1 [MASK_8] and
    iszero normalize_shift_8 jumpi
    normalize_skip_8:
    
    // Test 4-bit
    dup1 [MASK_4] and
    iszero normalize_shift_4 jumpi
    normalize_skip_4:
    
    // Test 2-bit
    dup1 [MASK_2] and
    iszero normalize_shift_2 jumpi
    normalize_skip_2:
    
    // Test 1-bit (IMPLICIT_BIT position)
    dup1 [MASK_1] and
    iszero normalize_shift_1 jumpi
    normalize_skip_1:
    
    // Now sig is normalized: leading bit at position 255 (the sign bit position)
    // Need to check if we're at IMPLICIT_BIT (2^236) or higher
    // After CLZ, sig should have leading 1 somewhere in top bits
    
    // Final adjustment: shift right until sig is in [2^236, 2^237)
    normalize_final_loop:
        dup1 [IMPLICIT_BIT]          // [IMPLICIT_BIT, sig, exp]
        swap1                         // [sig, IMPLICIT_BIT, exp]
        lt                            // [sig < IMPLICIT_BIT, exp]
        normalize_final_shift_left jumpi
        
        dup1 [IMPLICIT_BIT] dup1 add // [2^237, sig, exp]
        swap1                         // [sig, 2^237, exp]
        lt iszero                     // [sig >= 2^237, exp]
        normalize_final_shift_right jumpi
        
        // Normalized: remove implicit bit
        [IMPLICIT_BIT] swap1 sub      // [sig - 2^236, exp]
        normalize_end jump
    
    normalize_final_shift_left:
        dup2 [EXP_MIN_NORMAL] swap1 gt // [exp > EXP_MIN_NORMAL, sig, exp]
        iszero normalize_subnormal jumpi
        0x01 shl                      // [sig << 1, exp]
        swap1 0x01 swap1 sub swap1    // [sig << 1, exp - 1]
        normalize_final_loop jump
    
    normalize_final_shift_right:
        0x01 shr                      // [sig >> 1, exp]
        swap1 0x01 add swap1          // [sig >> 1, exp + 1]
        normalize_final_loop jump
    
    normalize_subnormal:
        swap1 pop 0x00 swap1          // [sig, 0]
        normalize_end jump
    
    // Binary search shift branches
    normalize_shift_128:
        0x80 shl                      // [sig << 128, exp]
        swap1 0x80 swap1 sub swap1    // [sig << 128, exp - 128]
        normalize_skip_128 jump
    
    normalize_shift_64:
        0x40 shl                      // [sig << 64, exp]
        swap1 0x40 swap1 sub swap1    // [sig << 64, exp - 64]
        normalize_skip_64 jump
    
    normalize_shift_32:
        0x20 shl                      // [sig << 32, exp]
        swap1 0x20 swap1 sub swap1    // [sig << 32, exp - 32]
        normalize_skip_32 jump
    
    normalize_shift_16:
        0x10 shl                      // [sig << 16, exp]
        swap1 0x10 swap1 sub swap1    // [sig << 16, exp - 16]
        normalize_skip_16 jump
    
    normalize_shift_8:
        0x08 shl                      // [sig << 8, exp]
        swap1 0x08 swap1 sub swap1    // [sig << 8, exp - 8]
        normalize_skip_8 jump
    
    normalize_shift_4:
        0x04 shl                      // [sig << 4, exp]
        swap1 0x04 swap1 sub swap1    // [sig << 4, exp - 4]
        normalize_skip_4 jump
    
    normalize_shift_2:
        0x02 shl                      // [sig << 2, exp]
        swap1 0x02 swap1 sub swap1    // [sig << 2, exp - 2]
        normalize_skip_2 jump
    
    normalize_shift_1:
        0x01 shl                      // [sig << 1, exp]
        swap1 0x01 swap1 sub swap1    // [sig << 1, exp - 1]
        normalize_skip_1 jump
    
    normalize_zero:
        pop pop 0x00 0x00             // [0, 0]

    normalize_end:
}

// ============================================================================
// CONVERSION
// ============================================================================

/// @notice Convert signed fixed32 to binary256 float format (IEEE 754)
/// @dev takes(1) returns(1)
/// Stack input: [fixed32_value] (signed int256 representing value * 1e32)
/// Stack output: [binary256_float] (packed; overflow -> ±Inf, underflow -> 0)
/// Strategy: 10^32 = 5^32 * 2^32. Divide by 5^32 exactly, account for 2^32 in exponent.
#define macro FP_FROM_FIXED32() = takes(1) returns(1) {
    // Input: [fixed32]
    
    dup1 iszero fp_from_zero jumpi
    
    // Extract sign: slt pops [top, next], returns top < next (signed)
    dup1 0x00 swap1 slt         // [is_neg, fixed32]
    
    // Get absolute value
    swap1                        // [fixed32, is_neg]
    dup2 iszero fp_from_positive jumpi
    0x00 sub                    // [abs, is_neg] (negate)
    fp_from_abs_ready jump
    
    fp_from_positive:

    fp_from_abs_ready:
    // Stack: [abs, sign]
    
    // Divide by 5^32 to remove base-5 component of 10^32
    // div pops [top, next], returns top / next
    [FIVE_POW_32] swap1 div     // [abs / 5^32, sign]
    
    // init_exp = bias + 204: value = (abs/5^32) * 2^(-32)
    // We need: sig * 2^(exp - bias - 236) = (abs/5^32) * 2^(-32)
    // So exp = bias + 236 - 32 = bias + 204
    0xCC [EXP_BIAS] add         // [bias + 204, quotient, sign]
    swap1                        // [quotient, bias + 204, sign]
    
    FP_NORMALIZE()              // [norm_sig, norm_exp, sign]
    
    // Check for exponent overflow
    dup2 [EXP_MAX_NORMAL] swap1 gt fp_from_overflow jumpi
    
    FP_PACK()                   // [packed]
    fp_from_end jump
    
    fp_from_overflow:
    pop pop
    iszero fp_from_pos_inf jumpi
    [NEG_INF]
    fp_from_end jump
    
    fp_from_pos_inf:
    [POS_INF]
    fp_from_end jump
    
    fp_from_zero:
    pop [POS_ZERO]
    
    fp_from_end:
}

/// @notice Convert binary256 float format to signed fixed32
/// @dev takes(1) returns(1)
/// Stack input: [binary256_float] (packed format)
/// Stack output: [fixed32_value] (signed int256, or 0 for Inf/NaN)
/// Strategy: Unpack, reconstruct value, multiply by 5^32 and shift by 32 to get * 10^32
#define macro FP_TO_FIXED32() = takes(1) returns(1) {
    // Input: [packed]
    
    dup1 iszero fp_to_zero jumpi
    
    FP_UNPACK()                // [sig, exp, sign]
    
    // Check for special exponent values
    dup2 [EXP_INF_NAN] eq fp_to_special jumpi
    dup2 [EXP_SPECIAL] eq fp_to_exp_zero jumpi
    
    // Normal number: add implicit bit
    [IMPLICIT_BIT] or          // [full_sig, exp, sign]
    
    // Value = full_sig * 2^(exp - bias - 236)
    // fixed32 = value * 10^32 = value * 5^32 * 2^32
    //         = full_sig * 2^(exp - bias - 204) * 5^32
    // To avoid overflow: apply 2^shift FIRST, then multiply by 5^32
    
    // Calculate shift: exp - bias - 204
    swap1                       // [exp, full_sig, sign]
    0xCC [EXP_BIAS] add        // [bias + 204, exp, full_sig, sign]
    swap1 sub                   // [exp - (bias+204), full_sig, sign] (sub: TOS - next)
    
    // Apply shift to full_sig first
    dup1 0x00 swap1 slt        // [shift < 0, shift, full_sig, sign]
    fp_to_shift_right jumpi
    
    // Shift left (positive shift)
    shl                         // [full_sig << shift, sign]
    fp_to_mul_5pow32 jump
    
    fp_to_shift_right:
    0x00 sub                   // [abs_shift, full_sig, sign]
    shr                         // [full_sig >> abs_shift, sign]
    
    fp_to_mul_5pow32:
    // Now multiply by 5^32 (result fits in 256 bits after the shift)
    [FIVE_POW_32] mul          // [result, sign]
    
    fp_to_apply_sign:
    swap1 iszero fp_to_done jumpi
    0x00 sub                   // [-result]
    fp_to_done jump
    
    fp_to_exp_zero:
    dup1 iszero fp_to_zero_result jumpi
    // Subnormal: extremely small, return 0
    pop pop pop 0x00
    fp_to_done jump
    
    fp_to_special:
    fp_to_zero_result:
    pop pop pop 0x00
    fp_to_done jump
    
    fp_to_zero:
    pop 0x00
    
    fp_to_done:
}

// ============================================================================
// ARITHMETIC MACROS
// ============================================================================

/// @notice Add two binary256 float numbers (IEEE 754 semantics)
/// @dev takes(2) returns(1)
/// Stack input: [b, a]
/// Stack output: [a + b]
/// Simple approach: convert to fixed32, add, convert back
#define macro FP_ADD() = takes(2) returns(1) {
    // Stack: [b, a]
    swap1 FP_TO_FIXED32()       // [f32_a, b]
    swap1 FP_TO_FIXED32()       // [f32_b, f32_a]
    add                          // [f32_a + f32_b]
    FP_FROM_FIXED32()
}

/// @notice Subtract two binary256 float numbers
/// @dev takes(2) returns(1)
/// Stack input: [b, a]
/// Stack output: [a - b]
#define macro FP_SUB() = takes(2) returns(1) {
    // Negate b and add: a - b = a + (-b)
    FP_UNPACK()                // [sig_b, exp_b, sign_b, a]
    swap2                       // [sign_b, exp_b, sig_b, a]
    iszero                      // [!sign_b, exp_b, sig_b, a]
    swap2                       // [sig_b, exp_b, !sign_b, a]
    FP_PACK()                  // [-b, a]
    swap1                       // [a, -b]
    FP_ADD()                   // [a + (-b)]
}

/// @notice Multiply two binary256 float numbers
/// @dev takes(2) returns(1)
/// Stack input: [b, a]
/// Stack output: [a * b]
/// Simple approach: convert to fixed32, multiply, convert back
/// Special values (Inf, NaN) map to 0 in fixed32, which is acceptable
#define macro FP_MUL() = takes(2) returns(1) {
    // Stack: [b, a]
    swap1 FP_TO_FIXED32()       // [f32_a, b]
    swap1 FP_TO_FIXED32()       // [f32_b, f32_a]
    // result_f32 = (f32_a * f32_b) / SCALE
    // sdiv: pops [top, next], returns top / next (signed)
    mul                          // [product]
    [FIXED32_SCALE]              // [SCALE, product]
    swap1                        // [product, SCALE]
    sdiv                         // [product / SCALE]
    FP_FROM_FIXED32()
}

/// @notice Divide two binary256 float numbers
/// @dev takes(2) returns(1)
/// Stack input: [b, a]
/// Stack output: [a / b]
/// Simple approach: convert to fixed32, divide with scaling, convert back
#define macro FP_DIV() = takes(2) returns(1) {
    // Stack: [b, a]
    swap1 FP_TO_FIXED32()       // [f32_a, b]
    swap1 FP_TO_FIXED32()       // [f32_b, f32_a]
    // result_f32 = (f32_a * SCALE) / f32_b
    // sdiv: pops [top, next], returns top / next (signed)
    swap1                        // [f32_a, f32_b]
    [FIXED32_SCALE] mul         // [f32_a * SCALE, f32_b]
    sdiv                         // [(f32_a * SCALE) / f32_b]
    FP_FROM_FIXED32()
}
