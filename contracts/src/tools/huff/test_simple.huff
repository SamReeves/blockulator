/// Simple test to verify basic Huff contract structure

#define macro MAIN() = takes(0) returns(0) {
    0x00 calldataload 0xe0 shr
    
    dup1 0xb9d92de8 eq test_jump jumpi
    0x00 0x00 revert
    
    test_jump:
        pop
        0x04 calldataload
        0x02 mul
        0x00 mstore
        0x20 0x00 return
}

#define function calculate(uint256) pure returns (uint256)
