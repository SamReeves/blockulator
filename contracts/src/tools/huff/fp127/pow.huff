/// @title FP127 Power Function
/// @notice x^y for 127.128 fixed-point arithmetic
/// @dev Requires: log2.huff, exp.huff, and arithmetic.huff must be included before this file
///
/// Algorithm:
///   x^y = 2^(y * log2(x))
///
/// Edge cases:
///   - y == 0: return 1 (x^0 = 1 for all x, including 0^0 = 1 by convention)
///   - x == 0: return 0 (0^y = 0 for y != 0)
///   - x == 1: return 1 (1^y = 1 for all y)
///   - x < 0: revert (fractional powers of negatives are undefined in reals)
///
/// Gas: ~6,500 (log2 ~3,500 + mul ~130 + exp2 ~2,500 + overhead)
/// Precision: ~126 fractional bits (compounded from log2 and exp2 precision)

/// @notice Compute x^y using log2 and exp2
/// @dev takes(2) returns(1)
/// Stack input:  [y, x] (both 127.128 format, signed)
/// Stack output: [x^y] (127.128 format)
#define macro FP127_POW() = takes(2) returns(1) {
    // Stack: [y, x]
    
    // Check if y == 0 (any x^0 = 1)
    dup1 iszero pow_y_zero jumpi
    
    // Check if x == 0 (0^y = 0 for y != 0)
    dup2 iszero pow_x_zero jumpi
    
    // Check if x == 1 (1^y = 1 for all y)
    dup2 [ONE_FP127] eq pow_x_one jumpi
    
    // Check if x < 0 (revert for negative base)
    dup2 IS_NEGATIVE() pow_x_negative jumpi
    
    // Main path: x^y = 2^(y * log2(x))
    swap1                      // [x, y]
    FP127_LOG2()               // [log2(x), y]
    FP127_MUL()                // [y * log2(x)]
    FP127_EXP2()               // [2^(y * log2(x)) = x^y]
    pow_done jump
    
    pow_y_zero:
    // y == 0: return 1
    pop pop                    // Clear stack
    [ONE_FP127]                // [1.0]
    pow_done jump
    
    pow_x_zero:
    // x == 0: return 0
    pop pop                    // Clear stack
    0x00                       // [0]
    pow_done jump
    
    pow_x_one:
    // x == 1: return 1
    pop pop                    // Clear stack
    [ONE_FP127]                // [1.0]
    pow_done jump
    
    pow_x_negative:
    // x < 0: revert (fractional powers of negatives are undefined)
    0x00 0x00 revert
    
    pow_done:
}
