#define function divUnsignedRaw(uint256,uint256) pure returns (uint256)
#define function pow(uint256,uint256) pure returns (uint256)
#define function powRaw(uint256,uint256) pure returns (uint256)
#define function abs(uint256) pure returns (uint256)
