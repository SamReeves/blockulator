        0x00 mstore
        0x20 0x00 return
    
    clamp_raw_jump:
        pop
        0x04 calldataload      // [x_fp127]
        0x24 calldataload      // [lo_fp127, x_fp127]
        0x44 calldataload      // [hi_fp127, lo_fp127, x_fp127]
        FP127_CLAMP()          // [result_fp127]
        0x00 mstore
        0x20 0x00 return
    
    avg_raw_jump:
        pop
        0x04 calldataload      // [a_fp127]
        0x24 calldataload      // [b_fp127, a_fp127]
        FP127_AVG()            // [result_fp127]
        0x00 mstore
        0x20 0x00 return
    
    zeroFloorSub_raw_jump:
        pop
        0x04 calldataload      // [a_fp127]
        0x24 calldataload      // [b_fp127, a_fp127]
        FP127_ZERO_FLOOR_SUB() // [result_fp127]
        0x00 mstore
        0x20 0x00 return
    
    dist_raw_jump:
