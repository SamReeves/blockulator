#define function dist(uint256,uint256) pure returns (uint256)
#define function gavg(uint256,uint256) pure returns (uint256)
#define function log10(uint256) pure returns (uint256)
#define function exp10(uint256) pure returns (uint256)
#define function absRaw(uint256) pure returns (uint256)
#define function negRaw(uint256) pure returns (uint256)
#define function invRaw(uint256) pure returns (uint256)
#define function minRaw(uint256,uint256) pure returns (uint256)
#define function maxRaw(uint256,uint256) pure returns (uint256)
#define function clampRaw(uint256,uint256,uint256) pure returns (uint256)
#define function avgRaw(uint256,uint256) pure returns (uint256)
#define function zeroFloorSubRaw(uint256,uint256) pure returns (uint256)
#define function distRaw(uint256,uint256) pure returns (uint256)
#define function gavgRaw(uint256,uint256) pure returns (uint256)
#define function log10Raw(uint256) pure returns (uint256)
#define function exp10Raw(uint256) pure returns (uint256)
#define function sign(uint256) pure returns (uint256)
#define function floor(uint256) pure returns (uint256)
#define function ceil(uint256) pure returns (uint256)
#define function frac(uint256) pure returns (uint256)
#define function cbrt(uint256) pure returns (uint256)
#define function lerp(uint256,uint256,uint256) pure returns (uint256)
#define function hypot(uint256,uint256) pure returns (uint256)
#define function signRaw(uint256) pure returns (uint256)
#define function floorRaw(uint256) pure returns (uint256)
#define function ceilRaw(uint256) pure returns (uint256)
#define function fracRaw(uint256) pure returns (uint256)
#define function cbrtRaw(uint256) pure returns (uint256)
#define function lerpRaw(uint256,uint256,uint256) pure returns (uint256)
#define function hypotRaw(uint256,uint256) pure returns (uint256)
#define function round(uint256) pure returns (uint256)
#define function log2Up(uint256) pure returns (uint256)
#define function gcd(uint256,uint256) pure returns (uint256)
#define function factorial(uint256) pure returns (uint256)
#define function lambertW0(uint256) pure returns (uint256)
#define function roundRaw(uint256) pure returns (uint256)
#define function log2UpRaw(uint256) pure returns (uint256)
#define function gcdRaw(uint256,uint256) pure returns (uint256)
#define function factorialRaw(uint256) pure returns (uint256)
#define function lambertW0Raw(uint256) pure returns (uint256)
#define function lambertW0Guess(uint256) pure returns (uint256)
#define function lambertW0CheckpointS(uint256) pure returns (uint256,uint256,uint256,uint256)
#define function lambertW0DbgLut(uint256) pure returns (uint256,uint256,uint256,uint256,uint256)
#define function lambertW0DbgFsc(uint256,uint256) pure returns (uint256,uint256)
#define function lambertW0DbgFscInit(uint256,uint256) pure returns (uint256,uint256,uint256)
#define function lambertW0DbgFscReuse(uint256,uint256,uint256) pure returns (uint256,uint256,uint256)
#define function dbgMsb(uint256) pure returns (uint256)
