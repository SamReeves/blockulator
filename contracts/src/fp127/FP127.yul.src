// FP127: signed 127.128 fixed-point arithmetic for the EVM.
//
// This file is the single source of truth. It contains only Yul function
// definitions. scripts/fp127/gen.py reads it and emits:
//   FP127.yul      a deployable object with a selector dispatcher
//   FP127Lib.sol   a Solidity library with one assembly block per export
//   IFP127.sol     the interface of the deployed object
//   abi.json       the ABI of the deployed object
//
// Rules (enforced by the generator):
//   * Top level holds only comments and `function` definitions.
//   * No object/code/data*/codecopy/calldataload/return/pc/jump. The
//     dispatcher and the library wrapper own calldata and returndata.
//   * The only literal memory addresses allowed are 0x00 and 0x20 (the
//     Solidity scratch space). Anything larger must be mload(0x40)-relative.
//   * Yul identifiers never start with an underscore. The library wrapper
//     uses underscore-prefixed Solidity names so nothing can shadow.
//   * Every exported function has an `/// @export` line giving its Solidity
//     signature. Helpers have none and are not dispatched.
//   * Reverts go through rev(sel) with a selector declared by `/// @error`.
//
// Representation: one int256, value = raw / 2^128. ONE = 2^128.
// Range: about +/- 1.7e38. Fraction: 128 bits, about 38 decimal digits.

/// @error Overflow() 0x35278d12
/// @error DivisionByZero() 0x23d359a3
/// @error OutOfRange() 0x7db3aba7

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

/// Revert with a 4-byte custom error selector. Uses scratch space only.
function rev(sel) {
    mstore(0x00, shl(224, sel))
    revert(0x00, 0x04)
}

/// |x| as an unsigned word. abs(-2^255) = 2^255, which is still a valid uint.
function absw(x) -> r {
    let m := sar(255, x)
    r := sub(xor(x, m), m)
}

// ---------------------------------------------------------------------------
// Conversions
// ---------------------------------------------------------------------------

/// @export fromFixed18(int256 x) returns (int256 r)
/// @notice Convert an 18-decimal fixed-point value to 127.128.
/// @dev r = sdiv(x << 128, 1e18), rounding toward zero (matches Huff).
///      Reverts with OutOfRange if |x| >= 2^127, where the shift would
///      lose bits. The Huff silently wrapped here.
function fp127_fromFixed18(x) -> r {
    if iszero(eq(sar(127, x), sar(255, x))) { rev(0x7db3aba7) }
    r := sdiv(shl(128, x), 1000000000000000000)
}

/// @export toFixed18(int256 x) returns (int256 r)
/// @notice Convert a 127.128 value to 18-decimal fixed-point.
/// @dev r = floor(x * 1e18 / 2^128), rounding toward negative infinity
///      (matches Huff: signed high word times 1e18 plus the truncated
///      unsigned low word product). Cannot overflow for any int256 input.
function fp127_toFixed18(x) -> r {
    let hi := sar(128, x)
    let lo := and(x, 0xffffffffffffffffffffffffffffffff)
    r := add(mul(hi, 1000000000000000000), shr(128, mul(lo, 1000000000000000000)))
}

// ---------------------------------------------------------------------------
// Arithmetic
// ---------------------------------------------------------------------------

/// @export add(int256 a, int256 b) returns (int256 r)
/// @notice a + b. Reverts with Overflow on signed overflow.
function fp127_add(a, b) -> r {
    r := add(a, b)
    if xor(slt(r, a), slt(b, 0)) { rev(0x35278d12) }
}

/// @export sub(int256 a, int256 b) returns (int256 r)
/// @notice a - b. Reverts with Overflow on signed overflow.
function fp127_sub(a, b) -> r {
    r := sub(a, b)
    if xor(sgt(r, a), slt(b, 0)) { rev(0x35278d12) }
}

/// @export mul(int256 a, int256 b) returns (int256 r)
/// @notice floor(a * b / 2^128), the 127.128 product.
/// @dev The full 512-bit signed product is formed as [p1:p0]. The unsigned
///      high word from mulmod is corrected to the signed high word by
///      subtracting b when a < 0 and a when b < 0. The result is the middle
///      256 bits of the 512-bit product, which is a floor toward negative
///      infinity, bit-identical to the Huff 4-term schoolbook on every
///      input where the Huff did not wrap. Reverts with Overflow when the
///      true result does not fit in int256; the Huff silently wrapped.
function fp127_mul(a, b) -> r {
    let p0 := mul(a, b)
    let mm := mulmod(a, b, not(0))
    let p1 := sub(sub(mm, p0), lt(mm, p0))
    p1 := sub(p1, mul(slt(a, 0), b))
    p1 := sub(p1, mul(slt(b, 0), a))
    if iszero(eq(sar(127, p1), sar(255, p1))) { rev(0x35278d12) }
    r := or(shl(128, p1), shr(128, p0))
}

/// Unsigned floor(a * 2^128 / b) for b != 0, requires (a >> 128) < b.
/// Remco Bloemen's mulDiv specialised to a constant multiplier of 2^128.
/// Verbatim port of FP127_DIV_UNSIGNED in arithmetic.huff.
function divu(a, b) -> q {
    let prod0 := shl(128, a)
    let prod1 := shr(128, a)
    let remainder := mulmod(a, 0x100000000000000000000000000000000, b)
    prod1 := sub(prod1, gt(remainder, prod0))
    prod0 := sub(prod0, remainder)
    let twos := and(sub(0, b), b)
    b := div(b, twos)
    prod0 := div(prod0, twos)
    prod0 := or(prod0, mul(prod1, add(div(sub(0, twos), twos), 1)))
    let inv := xor(mul(3, b), 2)
    inv := mul(inv, sub(2, mul(b, inv)))
    inv := mul(inv, sub(2, mul(b, inv)))
    inv := mul(inv, sub(2, mul(b, inv)))
    inv := mul(inv, sub(2, mul(b, inv)))
    inv := mul(inv, sub(2, mul(b, inv)))
    inv := mul(inv, sub(2, mul(b, inv)))
    q := mul(prod0, inv)
}

/// @export div(int256 a, int256 b) returns (int256 r)
/// @notice a / b in 127.128, truncated toward zero.
/// @dev Signs are stripped, the unsigned quotient floor(|a| * 2^128 / |b|)
///      is formed with a 512-by-256 division, and the sign is restored. That
///      is truncation toward zero, matching the Huff. Reverts with
///      DivisionByZero when b == 0 (the Huff returned garbage) and with
///      Overflow when the quotient does not fit in int256 (the Huff wrapped).
function fp127_div(a, b) -> r {
    if iszero(b) { rev(0x23d359a3) }
    let neg := xor(slt(a, 0), slt(b, 0))
    let ua := absw(a)
    let ub := absw(b)
    if iszero(lt(shr(128, ua), ub)) { rev(0x35278d12) }
    let q := divu(ua, ub)
    if gt(q, add(0x7fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff, neg)) { rev(0x35278d12) }
    r := sub(xor(q, sub(0, neg)), sub(0, neg))
}
